+  local scope, err = self.scope:child("tab:" .. tostring(tab))
+  if not scope then return nil, err end
+  state = {
+    tab = tab,
+    tab_number = vim.api.nvim_tabpage_get_number(tab),
+    scope = scope,
+    views = {},
+    return_window = nil,
+    return_buffer = nil,
+  }
