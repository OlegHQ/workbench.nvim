+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT))
+from tests.e2e.driver import Grid, git_head, parse_grids  # noqa: E402
+
+
+class Run:
+    def __init__(self, nvim: str, cols: int, rows: int, output: Path):
