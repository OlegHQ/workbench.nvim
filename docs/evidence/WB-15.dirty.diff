++local sample_count = 25
++local iterations = 500
++local registry = Actions.new()
++local app = Compose.new()
++local args = { query = "needle", include_hidden = false }
++for index = 1, 50 do
++  local action = {
++    id = "bench.action_" .. index,
++    title = "Benchmark action " .. index,
++    category = "Benchmark",
