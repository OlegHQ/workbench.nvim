++        self.lua("local args = ...; MiniFiles.open(args[1], false)", str(self.workspace))
++        self._wait_state(True, "resize probe open")
++        resized: list[dict[str, object]] = []
++        for cols, rows in GRIDS:
++            self._resize_grid(cols, rows)
