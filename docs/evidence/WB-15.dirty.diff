++TEST_XDG=$(mktemp -d "${TMPDIR:-/tmp}/autoconf-test.XXXXXX")
++trap 'rm -rf "$TEST_XDG"' EXIT HUP INT TERM
++mkdir -p "$TEST_XDG/config" "$TEST_XDG/data" "$TEST_XDG/state" "$TEST_XDG/cache"
