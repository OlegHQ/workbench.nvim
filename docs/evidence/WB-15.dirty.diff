++for nvim_bin in "$NVIM_MIN" "$NVIM_CURRENT"; do
++    if [ ! -x "$nvim_bin" ]; then
++        printf 'required Neovim binary not found: %s\n' "$nvim_bin" >&2
++        exit 1
++    fi
++    printf '== autoconf feature tests on %s ==\n' "$nvim_bin"
