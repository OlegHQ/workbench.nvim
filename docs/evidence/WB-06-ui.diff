+	  echo "== RPC UI grids on $$nvim_bin =="; \
+	  "$(PYTHON)" tests/e2e/driver.py --grid-sizes 160x50,120x35,80x24,60x20 --nvim "$$nvim_bin"; \
+	  "$(PYTHON)" tests/e2e/wb06_lifecycle.py --grid-sizes 160x50,120x35,80x24,60x20 --nvim "$$nvim_bin"; \
+	done
+
+test-e2e: bootstrap
